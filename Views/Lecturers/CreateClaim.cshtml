@model ContractMonthlyClaimSystem.Models.LecturerClaim

@{
    ViewData["Title"] = "Submit Claim";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-body p-4">
            <h2 class="text-center mb-4">📑 Submit Claim</h2>

            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- Lecturer Name -->
                <div class="mb-3">
                    <label asp-for="LecturerName" class="form-label"></label>
                    <input asp-for="LecturerName" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="LecturerName" class="text-danger"></span>
                </div>

                <!-- Date -->
                <div class="mb-3">
                    <label asp-for="DateSubmitted" class="form-label"></label>
                    <input asp-for="DateSubmitted" type="date" class="form-control" />
                    <span asp-validation-for="DateSubmitted" class="text-danger"></span>
                </div>

                <!-- Hours Worked -->
                <div class="mb-3">
                    <label asp-for="HoursWorked" class="form-label"></label>
                    <input asp-for="HoursWorked" type="number" class="form-control" min="1" max="200" placeholder="e.g. 20" />
                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                </div>

                <!-- Hourly Rate -->
                <div class="mb-3">
                    <label asp-for="HourlyRate" class="form-label"></label>
                    <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" placeholder="e.g. 500.00" />
                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                </div>

                <!-- File Upload -->
                <div class="mb-3">
                    <label for="LecturerDocument" class="form-label">Upload Supporting Document</label>
                    <input type="file" name="DocumentFile" class="form-control" aria-describedby="docHelp" />
                    <small id="docHelp" class="form-text text-muted">
                        Accepted formats: PDF, DOCX, JPG, PNG (max 5MB)
                    </small>
                </div>

                <!-- Submit Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg">
                        📤 Submit Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
