@model ContractMonthlyClaimSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2 class="mb-0">⚠️ An Error Occurred</h2>
        </div>
        <div class="card-body">
            <p class="lead text-danger">
                Sorry, something went wrong while processing your request.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-secondary">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <hr />

            <h4>Development Mode Info</h4>
            <p class="text-muted">
                Switching to <strong>Development</strong> environment will show more detailed error information.
            </p>
            <p class="text-muted">
                <strong>Note:</strong> The Development environment should not be enabled in production,
                as it may expose sensitive information. For local debugging, set <strong>ASPNETCORE_ENVIRONMENT</strong> to <strong>Development</strong> and restart the application.
            </p>

            <div class="mt-4">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-2">🏠 Go to Home</a>
                <a href="javascript:history.back()" class="btn btn-secondary">🔙 Go Back</a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: "Segoe UI", sans-serif;
    }

    h2 {
        font-weight: 600;
    }

    .lead {
        font-size: 1.1rem;
    }

    .alert {
        font-size: 0.95rem;
    }

    .btn {
        min-width: 120px;
    }

    .card-body h4 {
        margin-top: 20px;
    }
</style>
