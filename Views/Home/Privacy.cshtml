@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <h1 class="display-4 text-center mb-4">@ViewData["Title"]</h1>

    <p class="lead text-center">
        Your privacy is important to us. This page explains how we collect, use, and protect your information.
    </p>

    <hr class="my-4" />

    <!-- Information Collection -->
    <section class="mb-4">
        <h3>1. Information We Collect</h3>
        <p>
            We collect personal information you provide when registering or submitting claims,
            such as your name, email, department, and claim details.
            We also collect usage data to improve our system.
        </p>
    </section>

    <!-- How Information is Used -->
    <section class="mb-4">
        <h3>2. How We Use Your Information</h3>
        <ul>
            <li>To process and manage claims efficiently.</li>
            <li>To communicate important updates about your account or claims.</li>
            <li>To improve our system and user experience.</li>
        </ul>
    </section>

    <!-- Data Protection -->
    <section class="mb-4">
        <h3>3. Data Security</h3>
        <p>
            We implement appropriate technical and organizational measures to protect your data
            from unauthorized access, disclosure, or misuse. Only authorized personnel can access your information.
        </p>
    </section>

    <!-- Sharing Information -->
    <section class="mb-4">
        <h3>4. Sharing of Information</h3>
        <p>
            Your information will not be sold or shared with third parties except where required
            for legal compliance or system operations (e.g., HR or management processing claims).
        </p>
    </section>

    <!-- Contact -->
    <section class="mb-4">
        <h3>5. Contact Us</h3>
        <p>
            If you have questions about this privacy policy or your personal data, please contact us at:
        </p>
        <p><strong>Email:</strong> support@contractclaims.com</p>
    </section>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: "Segoe UI", sans-serif;
    }

    h1.display-4 {
        color: #007bff;
    }

    section h3 {
        color: #343a40;
        margin-top: 20px;
    }

    p, ul {
        font-size: 1.05rem;
        line-height: 1.6;
    }
</style>
