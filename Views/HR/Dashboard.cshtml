@model IEnumerable<ContractMonthlyClaimSystem.Models.LecturerClaim>

@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-3">📊 HR Dashboard: Lecturer Claims</h2>

    <!-- Filters -->
    <form asp-action="Filter" method="post" class="row g-3 mb-3">
        <div class="col-md-3">
            <input type="text" name="lecturerName" class="form-control" placeholder="Lecturer Name" />
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Status</option>
                <option value="Submitted">Submitted</option>
                <option value="Verified">Verified</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="fromDate" class="form-control" placeholder="From" />
        </div>
        <div class="col-md-2">
            <input type="date" name="toDate" class="form-control" placeholder="To" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
    </form>

    <!-- Status Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Lecturer</th>
                <th>Date</th>
                <th>Hours</th>
                <th>Total</th>
                <th>Status</th>
                <th>Document</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.ClaimId</td>
                    <td>@claim.LecturerName</td>
                    <td>@claim.DateSubmitted.ToShortDateString()</td>
                    <td>@claim.HoursWorked</td>
                    <td>R @claim.Total</td>
                    <td>
                        <span class="badge @(claim.Status == ClaimStatus.Submitted ? "bg-warning" :
                                                                           claim.Status == ClaimStatus.Verified ? "bg-primary" :
                                                                           claim.Status == ClaimStatus.Approved ? "bg-success" :
                                                                           "bg-danger")">
                        @claim.Status
                    </span>
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(claim.LecturerDocumentPath))
                        {
                            <a href="@claim.LecturerDocumentPath" class="btn btn-sm btn-outline-primary" target="_blank">View</a>
                        }
                        else
                        {
                            <span class="text-muted">No File</span>
                        }
                    </td>
                    <td class="d-flex gap-2">
                        <a asp-action="EditLecturer" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-info">Edit</a>
                        <a asp-action="GenerateInvoice" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-success">Invoice</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
