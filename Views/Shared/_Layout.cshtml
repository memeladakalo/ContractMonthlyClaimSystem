@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contract Monthly Claim System</title>

    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: "Segoe UI", sans-serif;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: 1px;
            color: #ffc107 !important;
        }

        footer {
            background-color: #0d6efd;
            color: white;
            font-size: 0.9rem;
        }

        .nav-link.active {
            font-weight: bold;
            color: #ffc107 !important;
            border-bottom: 2px solid #ffc107;
        }

        .role-badge {
            background-color: #ffc107;
            color: #000;
            font-weight: 500;
            padding: 0.25em 0.5em;
            border-radius: 0.25rem;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">CMCS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <!-- Home -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <!-- HR Dashboard -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HR" ? "active" : "")"
                           asp-controller="HR" asp-action="Dashboard">HR Dashboard</a>
                    </li>

                    <!-- Lecturer Menu -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lecturers" ? "active" : "")"
                           asp-controller="Lecturers" asp-action="SubmitClaim">Submit Claim</a>
                    </li>

                    <!-- Coordinator Menu -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coordinators" ? "active" : "")"
                           asp-controller="Coordinators" asp-action="Index">Coordinator Dashboard</a>
                    </li>

                    <!-- Manager Menu -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Managers" ? "active" : "")"
                           asp-controller="Managers" asp-action="Index">Manager Dashboard</a>
                    </li>

                    <!-- Authentication -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center ms-3">
                            <span class="role-badge me-2">@User.FindFirst("role")?.Value ?? "User"</span>
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">Logout (@User.Identity.Name)</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-center py-3 mt-5">
        <p class="mb-0">&copy; 2025 Contract Monthly Claim System | Developed for POE Project</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
