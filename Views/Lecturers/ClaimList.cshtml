@model IEnumerable<ContractMonthlyClaimSystem.Models.LecturerClaim>

@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "My Claims";
    var user = UserManager.GetUserAsync(User).Result;
    var roles = UserManager.GetRolesAsync(user).Result;
}

<div class="container mt-4">
    <h2 class="mb-4">📌 My Monthly Claims</h2>

    <!-- Role-Based Navigation -->
    <div class="mb-3 d-flex gap-2">
        <a class="btn btn-outline-primary" href="@Url.Action("Index", "Lecturers")">
            Lecturer View
        </a>

        @if (roles.Contains("Coordinator") || roles.Contains("Manager"))
        {
            <a class="btn btn-outline-warning" href="@Url.Action("VerifyClaims", "Coordinators")">
                Coordinator View
            </a>
        }

        @if (roles.Contains("Manager"))
        {
            <a class="btn btn-outline-success" href="@Url.Action("ReviewClaims", "Managers")">
                Manager View
            </a>
        }
    </div>

    <!-- Submit Claim Button -->
    <div class="mb-3">
        <a class="btn btn-primary btn-lg" href="@Url.Action("SubmitClaim", "Lecturers")">
            <i class="bi bi-upload"></i> Submit New Claim
        </a>
    </div>

    <!-- Status Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Claims Table with Progress & Filters -->
    <div class="mb-3 d-flex gap-2">
        <select id="statusFilter" class="form-select">
            <option value="">All Statuses</option>
            <option value="Submitted">Submitted</option>
            <option value="Verified">Verified</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>

        <input type="month" id="monthFilter" class="form-control" />
    </div>

    <table class="table table-bordered table-striped table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Hours</th>
                <th>Total (R)</th>
                <th>Status</th>
                <th>Progress</th>
                <th>Document</th>
            </tr>
        </thead>
        <tbody id="claimsTable">
            @foreach (var claim in Model)
            {
                <tr data-status="@claim.Status" data-month="@claim.DateSubmitted.ToString("yyyy-MM")">
                    <td>@claim.ClaimId</td>
                    <td>@claim.DateSubmitted.ToShortDateString()</td>
                    <td>@claim.HoursWorked</td>
                    <td>R @claim.Total</td>
                    <td>
                        <span class="badge
                                    @(claim.Status == ClaimStatus.Submitted ? "bg-warning text-dark" :
                                                                claim.Status == ClaimStatus.Verified ? "bg-primary" :
                                                                claim.Status == ClaimStatus.Approved ? "bg-success" :
                                                                claim.Status == ClaimStatus.Rejected ? "bg-danger" :
                                                                "bg-secondary")">
                                                                             @claim.Status
                                                                         </span>
                                                                     </td>
                                                                     <td>
                                                                         <div class="progress">
                                                                             <div class="progress-bar
                                    @(claim.Status == ClaimStatus.Submitted ? "bg-warning" :
                                                                   claim.Status == ClaimStatus.Verified ? "bg-primary" :
                                                                   claim.Status == ClaimStatus.Approved ? "bg-success" :
                                                                   claim.Status == ClaimStatus.Rejected ? "bg-danger" : "bg-secondary")"
                             role="progressbar"
                             style="width:@(claim.Status == ClaimStatus.Submitted ? 25 :
                                                                                  claim.Status == ClaimStatus.Verified ? 50 :
                                                                                  claim.Status == ClaimStatus.Approved ? 100 :
                                                                                  claim.Status == ClaimStatus.Rejected ? 100 : 0)%"
                             aria-valuenow="@(claim.Status == ClaimStatus.Submitted ? 25 :
                                                                                  claim.Status == ClaimStatus.Verified ? 50 :
                                                                                  claim.Status == ClaimStatus.Approved ? 100 :
                                                                                  claim.Status == ClaimStatus.Rejected ? 100 : 0)"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(claim.LecturerDocumentPath))
                        {
                            <a href="@claim.LecturerDocumentPath" class="btn btn-outline-secondary btn-sm" target="_blank">
                                View File
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No file</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#statusFilter, #monthFilter').on('change', function () {
                var selectedStatus = $('#statusFilter').val();
                var selectedMonth = $('#monthFilter').val();

                $('#claimsTable tr').each(function () {
                    var rowStatus = $(this).data('status');
                    var rowMonth = $(this).data('month');

                    var statusMatch = selectedStatus === "" || rowStatus === selectedStatus;
                    var monthMatch = selectedMonth === "" || rowMonth === selectedMonth;

                    $(this).toggle(statusMatch && monthMatch);
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        .progress {
            height: 20px;
        }

        .progress-bar {
            font-size: 0.85rem;
        }
    </style>
}
