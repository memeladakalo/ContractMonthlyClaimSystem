@model ContractMonthlyClaimSystem.Models.LecturerClaim

@{
    ViewData["Title"] = "Submit Claim";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Submit Monthly Claim
                    </h3>
                </div>

                <div class="card-body bg-light">
                    <form asp-action="Submit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label asp-for="LecturerName" class="form-label fw-semibold">Lecturer Name</label>
                            <input asp-for="LecturerName" class="form-control" placeholder="Enter your full name" value="@User.Identity.Name" readonly />
                            <span asp-validation-for="LecturerName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateSubmitted" class="form-label fw-semibold">Date</label>
                            <input asp-for="DateSubmitted" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateSubmitted" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HoursWorked" class="form-label fw-semibold">Hours Worked</label>
                            <input asp-for="HoursWorked" type="number" id="HoursWorked" class="form-control" placeholder="e.g. 25" />
                            <span asp-validation-for="HoursWorked" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HourlyRate" class="form-label fw-semibold">Hourly Rate (R)</label>
                            <input asp-for="HourlyRate" type="number" step="0.01" id="HourlyRate" class="form-control" placeholder="e.g. 500" />
                            <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                        </div>

                        <!-- Auto-calculated Total -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Total Amount (R)</label>
                            <input type="text" id="TotalAmount" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label for="Notes" class="form-label fw-semibold">Additional Notes</label>
                            <textarea id="Notes" name="Notes" class="form-control" rows="3" placeholder="Add any relevant details..."></textarea>
                        </div>

                        <!-- File Upload Section -->
                        <div class="mb-3">
                            <label asp-for="LecturerDocumentPath" class="form-label fw-semibold">Upload Supporting Document</label>
                            <input type="file" id="fileUpload" name="fileUpload" class="form-control"
                                   accept=".pdf,.docx,.xlsx" required />
                            <small class="text-muted d-block mt-1">Accepted formats: .pdf, .docx, .xlsx | Max size: 5MB</small>
                            <span id="fileNameDisplay" class="text-success fw-semibold mt-2 d-block"></span>
                            <span class="text-danger small" asp-validation-for="LecturerDocumentPath"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-send-fill me-2"></i> Submit Claim
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <small class="text-muted">
                        Ensure all claim details are correct before submitting.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            // Auto-calculate Total Amount
            $('#HoursWorked, #HourlyRate').on('input', function () {
                var hours = parseFloat($('#HoursWorked').val()) || 0;
                var rate = parseFloat($('#HourlyRate').val()) || 0;
                $('#TotalAmount').val((hours * rate).toFixed(2));
            });

            // Display selected file name & validate size
            $('#fileUpload').on('change', function () {
                const file = this.files[0];
                const display = $('#fileNameDisplay');

                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        alert("File size exceeds 5MB. Please upload a smaller file.");
                        this.value = "";
                        display.text('');
                    } else {
                        display.text(`Selected file: ${file.name}`);
                    }
                } else {
                    display.text('');
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .card {
            animation: fadeIn 1s ease-in-out;
        }

        .btn-success {
            background: linear-gradient(135deg, #198754, #28a745);
            border: none;
        }

            .btn-success:hover {
                background: linear-gradient(135deg, #157347, #218838);
            }

        #fileNameDisplay {
            font-size: 0.95rem;
        }
    </style>
}
